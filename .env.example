# Скопируйте в .env в корне репозитория (рядом с README). Не коммитьте .env.

# --- OpenAI API (чат и эмбеддинги по умолчанию) ---
OPENAI_API_KEY=your_openai_api_key_here

# Совместимый с OpenAI Chat Completions / Embeddings шлюз (опционально):
# Cloud.ru Foundation Models, прокси к vLLM, иные OpenAI-compatible эндпоинты
# OPENAI_BASE_URL=

OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=5
OPENAI_EMBED_RETRIES=5
RAG_EMBED_BATCH_SIZE=16

# --- Хранилище: журнал (SQLite), индекс Chroma, кеш ответов ---
# ЛОКАЛЬНО эти переменные НЕ задавайте: по умолчанию используются файлы в assistant_api/
# (logs.db, chroma_db/, api_rag_cache.db). Если задаёте — указывайте абсолютные пути.
#
# В DOCKER пути в /app/runtime задаёт docker-compose.yml (и Dockerfile). Не копируйте
# значения вида /app/runtime/... сюда: при локальном запуске такого каталога нет.
# LOGS_DB_PATH=
# RAG_CHROMA_PATH=
# RAG_CACHE_DB_PATH=

# --- Приватность журнала и /stats (по умолчанию включён приватный режим) ---
# Журнал (SQLite) по умолчанию хранит только метаданные: время, статус, модель, задержку, число
# источников и очищенный от ключей текст ошибки. Тексты вопросов и ответов НЕ сохраняются.
# Чтобы сохранять их (например, для локального разбора качества), задайте LOGS_STORE_TEXT=1;
# ключи вида sk-... в этих текстах всё равно заменяются на [REDACTED].
# Не включайте это в публичной демонстрации, если не собираетесь отвечать за хранение вопросов
# пользователей. На постоянный кеш ответов эта переменная не влияет (см. RAG_CACHE_ENABLED ниже).
# LOGS_STORE_TEXT=0
# Постоянный кеш ответов (SQLite, api_rag_cache.db) по умолчанию ВЫКЛЮЧЕН: пустое значение и отсутствие
# переменной = выключен. Если включить (1/true/yes/on), на диске в локальном файле (в Docker - в томе)
# будут храниться полные тексты вопросов и сгенерированных ответов и использованные фрагменты контекста.
# Не включайте это в публичной демонстрации, если не собираетесь отвечать за хранение вопросов
# пользователей. При выключенном кеше файл не создаётся и не читается, а поиск и вызов модели
# работают как обычно. Уже существующий api_rag_cache.db выключение не удаляет: удалите его вручную.
# RAG_CACHE_ENABLED=0
# /stats показывает только агрегаты (счётчики, кеш, задержки, модели) и НИКОГДА не показывает тексты
# вопросов и ответов. STATS_SHOW_RECENT=1 добавляет таблицу последних запросов, но только метаданные
# (время, статус, модель, задержка), без текстов и без текста ошибок.
# STATS_SHOW_RECENT=0

# --- RAG: модели и генерация ---
RAG_CHAT_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_MAX_TOKENS=1500
RAG_TEMPERATURE=0.3
# ОПЦИОНАЛЬНЫЙ порог «достаточности данных»: максимальное косинусное расстояние лучшего найденного
# фрагмента, число в диапазоне (0, 2]. Если лучший фрагмент дальше, чат-модель не вызывается, а
# пользователь получает ответ «в текущем корпусе недостаточно данных».
# По умолчанию (переменная не задана или пуста) отказ по расстоянию ОТКЛЮЧЁН.
# Шкала расстояний зависит от модели эмбеддингов (RAG_EMBEDDING_MODEL) и корпуса, поэтому порог нужно
# подбирать на реальных вопросах (по теме и вне темы корпуса) к развёрнутому индексу. Рекомендуемого
# значения нет. Нечисловое значение или число вне (0, 2] — ошибка конфигурации: ассистент не
# инициализируется (CLI завершается с сообщением, web отвечает 500 на /ask), другой порог не подставляется.
# RAG_MAX_DISTANCE=

# --- Индексация (при пустой коллекции Chroma) ---
# RAG_CHUNK_SIZE — целевой размер фрагмента: единица корпуса (часть, пункт, позиция) до 1.5x остаётся целой,
# крупнее делится по подпунктам и предложениям. RAG_CHUNK_OVERLAP используется только запасной
# нарезкой произвольного текста (data_file), для источников корпуса контекст повторяется заголовком.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_MIN_CHUNK_LEN=80

# Отпечаток корпуса (corpus_id) считается автоматически по содержимому файлов корпуса и
# параметрам индексации: он входит в имя коллекции Chroma и в ключ кеша.
# RAG_CORPUS_VERSION — ручная «соль»: увеличьте, чтобы принудительно переиндексировать
# корпус и сбросить кеш при неизменных файлах.
RAG_CORPUS_VERSION=1

# HTTPS_PROXY=http://127.0.0.1:7890

# --- Консоль app.py: превью контекста ---
# RAG_CLI_CONTEXT_MAX_ITEMS=0
# RAG_CLI_CONTEXT_PREVIEW_CHARS=220
